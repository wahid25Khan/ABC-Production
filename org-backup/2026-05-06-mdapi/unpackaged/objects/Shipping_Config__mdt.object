<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Carrier__c</fullName>
        <description>Shipping carrier name (e.g. &quot;USPS&quot;, &quot;UPS&quot;).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Carrier</label>
        <length>50</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Only active records are used by the shipping calculator.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Is Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Shipping_Method_Name__c</fullName>
        <description>Display name shown to the buyer at checkout (e.g. &quot;Standard Shipping&quot;).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Shipping Method Name</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shipping_Rate_Percent__c</fullName>
        <description>Shipping rate as a percentage of the shippable cart total (e.g. 12 means 12%).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Shipping Rate Percent</label>
        <precision>5</precision>
        <required>true</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Shipping Config</label>
    <pluralLabel>Shipping Configs</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
