<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>66.0</apiVersion>
  <isExposed>true</isExposed>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Default">
      <property
        name="storeName"
        type="String"
        label="Store Name"
        default="AmericanBookCompany" />
      <property
        name="webStoreId"
        type="String"
        label="Web Store ID"
        default="0ZEam000004dJDNGA2" />
      <property
        name="productId"
        type="String"
        label="Product ID Override"
        description="Optional. Leave blank to read the product id from the URL." />
      <property
        name="cartStateOrId"
        type="String"
        label="Cart State or Cart ID"
        default="current" />
      <property
        name="minimumQuantity"
        type="Integer"
        label="Minimum Quantity"
        default="10"
        min="1"
        max="999" />
      <property
        name="trialUrl"
        type="String"
        label="Trial URL"
        description="Optional URL to open when the free trial button is clicked." />
      <property
        name="showTrialButton"
        type="Boolean"
        label="Show Trial Button"
        default="true" />
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>