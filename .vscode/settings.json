{
  "files.exclude": {
    "**/.git": true,
    "**/.artifacts": true,
    "**/.sf": true,
    "**/.sfdx": true,
    "**/.svn": true,
    "**/.venv": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/core/build/repository/**": true,
    "**/core/ext/**": true,
    "**/target/**": true,
    "**/bin/**": true,
    "**/coverage": true,
    "META-INF/": true
  },
  "search.exclude": {
    "**/.artifacts/**": true,
    "**/.sf/**": true,
    "**/.sfdx/**": true,
    "**/.venv/**": true,
    "**/coverage/**": true,
    "**/node_modules/**": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.artifacts/**": true,
    "**/.sf/**": true,
    "**/.sfdx/**": true,
    "**/.venv/**": true,
    "**/coverage/**": true,
    "**/node_modules/**": true,
    "**/core/build/repository/**": true,
    "**/core/ext/**": true,
    "**/target/**": true,
    "**/bin/**": true
  },
  "salesforcedx-vscode-lightning.activationMode": "always",
  "salesforcedx-vscode-lightning.showLightningExplorer": true,
  "salesforcedx-vscode-core.internal-development": false,
  "eslint.workingDirectories": [
    "/Users/mac/Development/ABC-Production"
  ],
  "eslint.validate": [
    "javascript",
    "typescript"
  ],
  "eslint.useFlatConfig": true,
  "salesforcedx-vscode-slds.enabled": false,
  "salesforcedx-vscode-slds.file.scopeWithInSFDX": true,
  "salesforcedx-vscode-slds.basic.override": false,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "xml.preferences.showSchemaDocumentationType": "none"
}