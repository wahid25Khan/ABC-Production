<messaging:emailTemplate subject="Your ABC Shipping Confirmation for Order #{!relatedTo.OrderNumber}" 
                         recipientType="Contact" 
                         relatedToType="Order">

  <messaging:htmlEmailBody >
    <html>
      <head>
        <style type="text/css">
            .blueTable {
                border: 1px solid #1C6EA4;
                background-color: #FFFFFF;
                width: 100%;
                border-collapse: collapse;
            }
            .blueTable th {
                background: #0071BC;
                background: linear-gradient(to bottom, #0071BC 0%, #327cad 66%, #1C6EA4 100%);
                color: #FFFFFF;
                padding: 10px;
                font-size: 15px;
                font-weight: bold;
                border: 1px solid #0071BC;
                text-align: center;
            }
            .blueTable td {
                border: 1px solid #0071BC;
                padding: 10px;
                font-size: 13px;
                color: #333;
                word-wrap: break-word;
            }
            .blueTable tr.alt-row {
                background-color: #D0E4F5;
            }
            .es-button {
                text-decoration: none;
                color: #FFFFFF;
                background: #0071BC;
                padding: 10px 20px;
                display: inline-block;
                font-size: 18px;
                border-radius: 0px;
            }
        </style>
      </head>
      <body style="margin:0; padding:0; background:#ffffff; font-family: Arial, sans-serif;">
        <table width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#ffffff;">
          <tr>
            <td align="center">
              <table width="600" cellspacing="0" cellpadding="0" border="0" style="width:600px; background:#ffffff;">
                
                <tr>
                    <td align="right" style="padding: 10px;">
                        <a href="#" style="font-size: 12px; color: #0B5394; text-decoration: none;">Click here to view in browser</a>
                    </td>
                </tr>

                

                <tr>
                    <td align="center" style="padding: 30px 20px; color: #696969; font-size: 14px; line-height: 1.5;">
                        Hello {!recipient.FirstName},<br/>
                        Great news - your ABC order is on the way!
                    </td>
                </tr>

                <tr>
                    <td align="center" style="padding-bottom: 30px;">
                        <a href="https://www.fedex.com/fedextrack/?trknbr={!relatedTo.OrderReferenceNumber}" class="es-button">Track Package</a>
                    </td>
                </tr>

                <tr>
                    <td style="padding: 0 20px 30px 20px;">
                        <table width="100%" cellspacing="0" cellpadding="0" border="0">
                            <tr>
                                <td width="40%" align="center">
                                    <div style="color: #0B5394; font-weight: bold; font-size: 20px;">ABC Order Number</div>
                                    <div style="font-size: 20px; color: #333333; margin-top: 10px;">{!relatedTo.OrderNumber}</div>
                                </td>
                                <td width="20%" align="center" valign="middle">
                                    <div style="border-bottom: 1px solid #0B5394; width: 80%;">&nbsp;</div>
                                </td>
                                <td width="40%" align="center">
                                    <div style="color: #0B5394; font-weight: bold; font-size: 20px;">PO Number</div>
                                    <div style="font-size: 20px; color: #333333; margin-top: 10px;">{!relatedTo.PoNumber}</div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td align="center" style="padding-bottom: 20px; font-size: 14px; color: #333;">
                        <strong>SHIPPING TYPE:</strong> Ground Shipping (3-6 business days)
                    </td>
                </tr>

                <tr>
                    <td align="center" bgcolor="#0071BC" style="height: 25px;">&nbsp;</td>
                </tr>
                <tr>
                    <td align="center" style="padding: 20px;">
                        <div style="color: #0071BC; font-size: 25px; font-weight: bold;">FedEx Tracking Number</div>
                        <div style="color: #9E005D; font-size: 24px; margin-top: 10px; text-decoration: underline;">
                            {!relatedTo.OrderReferenceNumber}
                        </div>
                        <p style="font-size: 14px; color: #333; margin-top: 20px;">
                            If you have any question in the meantime, please don’t hesitate to reach out to <strong>{!relatedTo.Owner.Email}</strong>
                        </p>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="#0071BC" style="height: 25px;">&nbsp;</td>
                </tr>

                <tr>
                    <td align="center" style="padding: 30px 20px;">
                        <div style="color: #0071BC; font-size: 25px; font-weight: bold;">Shipped to</div>
                        <div style="font-size: 18px; color: #333; margin-top: 15px; line-height: 1.4;">
                            {!relatedTo.ShippingStreet}<br/>
                            {!relatedTo.ShippingCity}, {!relatedTo.ShippingState} {!relatedTo.ShippingPostalCode}
                        </div>
                    </td>
                </tr>

                <tr>
                    <td style="padding: 0 20px 30px 20px;">
                        <table class="blueTable">
                            <thead>
                                <tr>
                                    <th>QTY</th>
                                    <th>TITLE</th>
                                    <th>ISBN</th>
                                </tr>
                            </thead>
                            <tbody>
                                <apex:variable value="{!0}" var="rowNum"/>
                                <apex:repeat value="{!relatedTo.OrderItems}" var="oi">
                                    <tr class="{!IF(MOD(rowNum, 2) == 0, '', 'alt-row')}">
                                        <td align="center">{!oi.Quantity}</td>
                                        <td>{!oi.Product2.Name}</td>
                                        <td align="center">{!oi.Product2.ProductCode}</td>
                                    </tr>
                                    <apex:variable var="rowNum" value="{!rowNum + 1}"/>
                                </apex:repeat>
                            </tbody>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td align="center" style="padding-bottom: 30px;">
                        <a href="https://gl1kzmhy.sibpages.com/" class="es-button" style="padding: 10px 50px;">Join our Newsletter</a>
                    </td>
                </tr>

                <tr>
                    <td align="center" bgcolor="#0071BC" style="padding: 15px;">
                        <a href="http://www.americanbookcompany.com" style="color: #FFFFFF; font-size: 12px; text-decoration: none;">www.americanbookcompany.com</a>
                    </td>
                </tr>

              </table>
            </td>
          </tr>
        </table>
      </body>
    </html>
  </messaging:htmlEmailBody>
</messaging:emailTemplate>