<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exceed_6_percent_of_Shipping</fullName>
    <active>false</active>
    <errorConditionFormula>ShippingHandling  &lt; (Subtotal * 0.94)</errorConditionFormula>
    <errorMessage>Shipping discount cannot exceed 6% of the shipping amount.</errorMessage>
</ValidationRule>
