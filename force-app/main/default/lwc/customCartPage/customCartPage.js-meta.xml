<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Custom Cart Page</masterLabel>
    <description>Custom cart page with integrated order summary and wishlist shelf.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="heading" type="String" label="Heading" default="Your Cart" />
            <property name="storeName" type="String" label="Store Name" default="AmericanBookCompany" />
            <property name="webStoreId" type="String" label="Web Store Id" default="0ZEam000004dJDNGA2" />
            <property name="checkoutUrl" type="String" label="Checkout URL" default="/checkout" />
            <property name="poSubmissionUrl" type="String" label="PO Submission URL" default="/submit-a-po" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>