                    "imageInfos" : "",
                    "richTextValue" : "<div style=\"width:100%; max-width:1200px; margin:0 auto; font-family: 'Segoe UI', Arial, sans-serif;\">\n  \n  <div style=\"\n      background-color:#167DA6;\n      color:white;\n      text-align:center;\n      padding:80px 20px 100px 20px;\n      position:relative;\n      overflow:hidden;\n      border-radius:4px;\n  \">\n\n    <!-- Top Right Red Shape -->\n    <div style=\"\n        position:absolute;\n        top:-120px;\n        right:-120px;\n        width:300px;\n        height:300px;\n        background:#E3171E;\n        border-radius:50%;\n    \"></div>\n\n    <!-- Bottom Left Yellow Shape -->\n    <div style=\"\n        position:absolute;\n        bottom:-150px;\n        left:-150px;\n        width:400px;\n        height:400px;\n        background:#FDB913;\n        border-radius:50%;\n    \"></div>\n\n    <!-- Content -->\n    <h1 style=\"\n        font-size:40px;\n        font-weight:600;\n        margin-bottom:25px;\n        position:relative;\n        z-index:2;\n    \">\n      Need help?\n    </h1>\n\n    <p style=\"\n        font-size:18px;\n        max-width:700px;\n        margin:0 auto 35px auto;\n        line-height:1.6;\n        position:relative;\n        z-index:2;\n    \">\n      Your Georgia representatives are here to personally help you determine the best solution for you.\n    </p>\n\n    <!-- Email Button -->\n    <a href=\"mailto:contact@americanbookcompany.com\"\n       style=\"\n          display:inline-block;\n          padding:14px 30px;\n          border:2px solid #ffffff;\n          border-radius:30px;\n          color:#ffffff;\n          text-decoration:none;\n          font-size:16px;\n          font-weight:500;\n          transition:all 0.3s ease;\n          position:relative;\n          z-index:2;\n       \">\n       Email Our Sales Team\n    </a>\n\n    <!-- Phone & Fax -->\n    <div style=\"\n        margin-top:40px;\n        font-size:16px;\n        line-height:1.8;\n        position:relative;\n        z-index:2;\n    \">\n      Phone: (888) 264-5877<br>\n      Fax: (866) 827-3240\n    </div>\n\n  </div>\n</div>"
