                "imageInfos" : "",
                "richTextValue" : "<div style=\"font-family: Arial, sans-serif; color: #444; line-height: 1.6;\">\n\n    <div\n        style=\"background-image: url('https://americanbookcompany.com/images/careers/ABCCareersHeader.svg'); background-size: cover; background-position: center top; background-repeat: no-repeat; padding: 80px 20px; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n        <h1 style=\"font-size: 36px; font-weight: bold; color: #0066b2; margin-bottom: 20px;\">\n            Careers at <span style=\"display: block;\">American Book Company</span>\n        </h1>\n        <p style=\"max-width: 600px; margin: 0 auto; font-size: 16px; color: #333;\">\n            At American Book Company we believe our people are the secret to creating great classroom solutions and\n            helping students across the United States achieve success.\n        </p>\n        <div style=\"margin-top: 40px;\">\n            <a href=\"#career-list\"\n                style=\"display: inline-block; background-color: #0066b2; color: #ffffff; text-decoration: none; padding: 12px 30px; border-radius: 9999px; font-weight: bold; border: 2px solid #0066b2; transition: all 0.3s ease;\">\n                View Open Positions\n            </a>\n        </div>\n    </div>\n\n    <div style=\"max-width: 1000px; margin: 0 auto; padding: 60px 20px; text-align: center;\">\n        <h2 style=\"font-size: 28px; font-weight: bold; color: #000; margin-bottom: 10px;\">Benefits Of Working at ABC\n        </h2>\n        <p style=\"color: #666; margin-bottom: 50px;\">Our employees are our most valuable assets. We offer competitive\n            benefits and a great work environment.</p>\n\n        <div style=\"display: flex; flex-wrap: wrap; gap: 40px; text-align: left; justify-content: center;\">\n\n            <div style=\"flex: 1 1 45%; min-width: 300px; display: flex; align-items: flex-start;\">\n                <img src=\"sfsites/c/resource/1773322608000/heart_Image\"\n                    style=\"width:40px;height:auto;color:#0066b2;\">\n                <div>\n                    <h3 style=\"font-size: 22px; font-weight: bold; margin: 0 0 15px 0; color: #000;\">Health &amp;\n                        Wellness</h3>\n                    <ul style=\"list-style: none; padding: 0; margin: 0;\">\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; background-color: #f9fafb; font-size: 15px;\">\n                            American Book Company provides a comprehensive health care plan consisting of medical,\n                            dental, and vision benefit options.</li>\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; font-size: 15px;\">\n                            We also provide life insurance, short and long term disability, and an employee assistance\n                            program.</li>\n                    </ul>\n                </div>\n            </div>\n\n            <div style=\"flex: 1 1 45%; min-width: 300px; display: flex; align-items: flex-start;\">\n                <img src=\"sfsites/c/resource/1773325716000/Clock_Image\"\n                    alt=\"Schedule\" style=\"width: 40px; height: 40px; flex-shrink: 0; margin-right: 15px;\">\n                <div>\n                    <h3 style=\"font-size: 22px; font-weight: bold; margin: 0 0 15px 0; color: #000;\">Flexible Schedule\n                        &amp; Paid Time Off</h3>\n                    <ul style=\"list-style: none; padding: 0; margin: 0;\">\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; background-color: #f9fafb; font-size: 15px;\">\n                            American Book Company offers flexible work hours for full and part time employees.</li>\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; font-size: 15px;\">\n                            Full time employees begin accruing paid vacation right away.</li>\n                    </ul>\n                </div>\n            </div>\n\n            <div style=\"flex: 1 1 45%; min-width: 300px; display: flex; align-items: flex-start;\">\n                <img src=\"sfsites/c/resource/1773325759000/Animal_Image\"\n                    alt=\"Planning\" style=\"width: 40px; height: 40px; flex-shrink: 0; margin-right: 15px;\">\n                <div>\n                    <h3 style=\"font-size: 22px; font-weight: bold; margin: 0 0 15px 0; color: #000;\">Planning for the\n                        Future</h3>\n                    <ul style=\"list-style: none; padding: 0; margin: 0;\">\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; background-color: #f9fafb; font-size: 15px;\">\n                            American Book Company offers a 401(k) plan with employer match.</li>\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; font-size: 15px;\">\n                            Employees are eligible to participate after six months of employment.</li>\n                    </ul>\n                </div>\n            </div>\n\n            <div style=\"flex: 1 1 45%; min-width: 300px; display: flex; align-items: flex-start;\">\n                <img src=\"sfsites/c/resource/1773325915000/Light_Image\"\n                    alt=\"Learning\" style=\"width: 40px; height: 40px; flex-shrink: 0; margin-right: 15px;\">\n                <div>\n                    <h3 style=\"font-size: 22px; font-weight: bold; margin: 0 0 15px 0; color: #000;\">Learning &amp;\n                        Development</h3>\n                    <ul style=\"list-style: none; padding: 0; margin: 0;\">\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; background-color: #f9fafb; font-size: 15px;\">\n                            To encourage professional development, American Book Company offers a tuition assistance\n                            program to eligible employees who complete job-related courses.</li>\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; font-size: 15px;\">\n                            All full-time employees with one year or more of service are eligible to participate in the\n                            program.</li>\n                    </ul>\n                </div>\n            </div>\n\n            <div\n                style=\"flex: 1 1 100%; max-width: 900px; margin: 0 auto; display: flex; align-items: flex-start; margin-top: 10px;\">\n                <img src=\"sfsites/c/resource/1773325945000/Group_Image\"\n                    alt=\"Diversity\" style=\"width: 40px; height: 40px; flex-shrink: 0; margin-right: 15px;\">\n                <div>\n                    <h3 style=\"font-size: 22px; font-weight: bold; margin: 0 0 15px 0; color: #000;\">Diversity &amp;\n                        Culture</h3>\n                    <ul style=\"list-style: none; padding: 0; margin: 0;\">\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; background-color: #f9fafb; font-size: 15px;\">\n                            We embrace the diversity of our team and make inclusion part of our core values.</li>\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; font-size: 15px;\">\n                            We celebrate the unique perspectives and skills each team member brings to work every day.\n                        </li>\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; background-color: #f9fafb; font-size: 15px;\">\n                            A diverse team makes our solutions–the books and digital programs used in classrooms\n                            throughout the country–more accessible and engaging for all.</li>\n                        <li\n                            style=\"border-left: 4px solid #8ab4f8; padding: 12px 16px; margin-bottom: 5px; font-size: 15px;\">\n                            American Book Company provides equal opportunities to all employees and applicants for\n                            employment without regard to race, religion, color, age, sex, national origin, sexual\n                            orientation, gender identity, genetic disposition, neurodiversity, disability, veteran\n                            status or any other protected category under federal, state, and local law.</li>\n                    </ul>\n                </div>\n            </div>\n\n        </div>\n    </div>\n\n    <div id=\"career-list\" style=\"background-color: #f3f4f6; padding: 50px 20px; text-align: center;\">\n        <p style=\"font-size: 16px; color: #444; margin: 0;\">\n            Sorry, there are no openings available at this time....\n        </p>\n    </div>\n\n</div>"
