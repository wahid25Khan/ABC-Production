            "sectionConfig" : "{\"UUID\":\"8b9a7e61-74ed-4f19-b2e0-b871ea63e9e7\",\"columns\":[{\"UUID\":\"324164f1-f2bb-4d5b-a844-301c8ab91c43\",\"columnName\":\"Column 1\",\"columnKey\":\"col1\",\"columnWidth\":\"12\",\"seedComponents\":[]}]}",
