                        "imageInfos" : "",
                        "richTextValue" : "<h2 style=\"text-align: center;\"><strong style=\"font-size: 26px;\">ABC Cares</strong></h2><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><span style=\"font-size: 16px;\">ABC cares about our communities and the schools we serve. We know that curriculum is only one part of student success and that strong communities ﻿and</span></p><p style=\"text-align: center;\"><span style=\"font-size: 16px;\"> make all the difference. In our home state of Georgiaand the other states we serve, we believe in being part of those strong communities.</span></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><span style=\"font-size: 16px;\">From backpack drives to charity tournaments to helping students and teachers get back on their feet after natural disasters, we will be here to help.</span></p>"
