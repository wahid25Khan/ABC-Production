                "richTextValue" : "<div style=\"font-family: Arial, sans-serif; color: #444; max-width: 1200px; margin: 0 auto; padding: 20px;\">\n\n    <div style=\"display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; margin-bottom: 30px;\">\n        <div style=\"flex: 1; min-width: 300px;\">\n            <h1 style=\"font-size: 26px; font-weight: bold; color: #333; margin: 0 0 15px 0;\">ABC Documents for Ordering</h1>\n            <p style=\"font-size: 13px; margin: 3px 0;\">BuyBoard #748-24</p>\n            <p style=\"font-size: 13px; margin: 3px 0;\">Vendor with North Carolina E-Procurement</p>\n            <p style=\"font-size: 13px; margin: 3px 0;\">Member of Kentucky KPC</p>\n        </div>\n        <div style=\"background-color: #f4f7f9; padding: 15px 20px; border-radius: 4px; width: 280px;\">\n            <h3 style=\"font-size: 17px; margin: 0 0 8px 0;\">Need Help Ordering?</h3>\n            <p style=\"font-size: 12px;\">Visit our <a href=\"/AmericanBookCompany/how-to-order\">How to Order</a> or call 1-888-264-5877</p>\n        </div>\n    </div>\n\n    <h2 style=\"font-size: 18px; font-weight: bold; margin-bottom: 8px;\">Sole source letters</h2>\n    \n    <div class=\"book-grid\">\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/all.state.source.letter.021726.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694703000/thumb_ALLSTATE\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/al.source.letter.020926.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694649000/thumb_AL\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/ar.source.letter.103125.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694737000/thumb_AR\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/ga.source.letter.103125.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694763000/thumb_GA\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/ky.source.letter.040326.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694790000/thumb_KY\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/la.source.letter.110325.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694812000/thumb_LA\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        \n        <div class=\"spacer-div\"></div>\n\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/mn.source.letter.110425.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694838000/thumb_MN\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/nc.source.letter.102125.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694864000/thumb_NC\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/nm.source.letter.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694889000/thumb_NM\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/ok.source.letter.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694913000/thumb_OK\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/sc.source.letter.pdf\" target=\"_blank\"><img src=\"sfsites/c/resource/1773694948000/thumb_SC\" style=\"width:130px; border:1px solid #ddd;\"></a>\n        <a href=\"https://cms-assets.americanbookcompany.com/sole_source_letters/tn.source.letter.pdf\" target=\"_blank\"><im